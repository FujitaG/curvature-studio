{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curvature Studio polyhedron v1",
  "description": "Edges are authoritative when both edges and faces exist. Runtime also checks endpoint ranges and duplicate undirected edges. File limit: 8 MiB.",
  "type": "object",
  "properties": {
    "format": {
      "const": "curvature-studio/polyhedron"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "vertices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      }
    },
    "faces": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 1000,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      }
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "vertices"
  ],
  "anyOf": [
    {
      "required": [
        "edges"
      ]
    },
    {
      "required": [
        "faces"
      ],
      "properties": {
        "faces": {
          "minItems": 1
        }
      }
    }
  ],
  "additionalProperties": true
}
